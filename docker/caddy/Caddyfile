# HTTPS-вход на локальном контуре.
#
# Нужен для входа через VK ID: VK принимает только https в доверенном
# адресе возврата, а сайт и API у нас слушают http (:3000 и :8088).
# Прокси даёт один https-origin на оба: фронт и `/api/v1/*` — иначе
# страница по https не смогла бы обратиться к http-API (mixed content
# браузер режет).
#
# Сертификат — самоподписанный, Caddy выпускает его сам (`tls internal`).
# Браузер один раз предупредит о недоверенном центре сертификации —
# это нормально: сертификат проверяет только браузер разработчика,
# сам VK на наш адрес не ходит (он лишь перенаправляет туда браузер,
# а кодом на токен обменивается backend напрямую с id.vk.ru).
{
	admin off
	# Редиректы с :80 внутри контейнера не нужны и только мешают.
	auto_https disable_redirects
	# Браузер при заходе по IP не шлёт SNI — без этого Caddy не знал бы,
	# какой сертификат предъявить.
	default_sni avtovokzal57.local
}

# Имена указаны явно: для безымянного блока Caddy не может выпустить
# сертификат (нечего вписать в CN) и рвёт TLS-рукопожатие.
# `avtovokzal57.local` — рабочее имя контура: VK ID не принимает
# нестандартные порты в адресе возврата, поэтому сайт открывается как
# https://avtovokzal57.local (порт 443). Имя резолвится через /etc/hosts.
https://avtovokzal57.local, https://localhost, https://127.0.0.1 {
	tls internal

	# Высокоуровневое API avtovokzal57 (backend). Только /api/v1/* —
	# у самого Nuxt есть свои серверные маршруты /api/auth/session,
	# они обязаны остаться на фронте.
	handle /api/v1/* {
		reverse_proxy web:80
	}

	handle {
		reverse_proxy frontend:3000
	}
}
