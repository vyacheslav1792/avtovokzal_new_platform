# Публичный адрес сайта — ОДНО место на весь монорепо.
# Отсюда compose раздаёт его всем сервисам: NUXT_PUBLIC_SITE_URL (фронт),
# FRONTEND_URL (backend: ссылки писем, адрес возврата платёжного шлюза,
# redirect_uri VK), SITE_FRONTEND_URL (ais-api: ссылки печати в отчётах),
# VITE_SITE_URL (ais-spa). Прод: https://site.orelavtotrans.ru
SITE_URL=http://127.0.0.1:3000

# Порты, публикуемые на хост
WEB_PORT=8080
SALES_WEB_PORT=8085
KKM_WEB_PORT=8087
AIS_WEB_PORT=8086
AIS_SPA_PORT=3001
FRONTEND_PORT=3000
DB_PORT=5432

# uid/gid хоста для php-контейнера (bind mounts без проблем с правами)
UID=1000
GID=1000

# PostgreSQL (наши базы)
POSTGRES_DB=avtovokzal
POSTGRES_USER=avtovokzal
POSTGRES_PASSWORD=change_me_in_env

# Firebird (dev): восстановленные бэкапы
FB_PORT=3050
FB_PASSWORD=masterkey

# Хост zebedee-туннелей до баз станций (прод; используется shared/stations.php)
#STATIONS_TUNNEL_HOST=127.0.0.1

# DNS backend в проде (docker-compose.prod.yml): платёжный шлюз и внешние API.
#APP_DNS_PRIMARY=192.168.2.100

# Yandex SmartCaptcha на форме обратной связи (страница /feedback).
# Клиентский ключ (ysc1_…) уходит во фронт, серверный (ysc2_…) —
# в backend/.env как CAPTCHA_SERVER_KEY. Пустой ключ = капчи нет.
CAPTCHA_CLIENT_KEY=

# Версия сайта для людей с нарушениями зрения (ГОСТ Р 52872-2019): кнопка
# «Для слабовидящих» в шапке и панель настроек отображения. 1 — включена,
# 0 — кнопки и всей версии на сайте нет.
ACCESSIBILITY_VERSION=1

# PWA: сайт ставится на телефон как приложение, купленные билеты
# открываются без интернета (service worker + IndexedDB). 1 — включено,
# 0 — ни service worker, ни кнопки установки. В dev-режиме service worker
# не регистрируется в любом случае.
PWA=1

# Станционная система старого сайта (/stations/**) — пока проксируем, не переносили.
# Ходим по ДОМЕННОМУ имени (совпадают Host, SNI и сертификат), а само имя
# указывает на старый сервер через extra_hosts контейнера frontend: в DNS
# оно уже ведёт на новый сервер. На проде:
#   LEGACY_SITE_PROXY=https://xn--57-6kcaja9axlzb9b.xn--p1ai
#   LEGACY_SITE_HOST=xn--57-6kcaja9axlzb9b.xn--p1ai
#   LEGACY_SITE_IP=192.168.2.5
LEGACY_SITE_PROXY=
LEGACY_SITE_HOST=
LEGACY_SITE_IP=192.168.2.5
